# 通知服务环境变量示例（本地与 compose 共用）。
# 未设置时使用 internal/conf 中的本地开发默认值（技术方案第 13 节初始建议）。

# Azure Key Vault：部署时设置 URL 与密钥名称；密钥值不写入环境变量。
# 未设置 URL 时使用下面的本地环境变量。启用后 MYSQL_DSN_SECRET 必填，
# Key Vault 密钥覆盖本地值，读取失败或值为空时启动失败。
# 身份由 Azure SDK DefaultAzureCredential 提供，Azure 上推荐托管身份。
AZURE_KEY_VAULT_URL=
AZURE_KEY_VAULT_TIMEOUT=15s
MYSQL_DSN_SECRET=
REDIS_PASSWORD_SECRET=

# HTTP 接入
HTTP_ADDR=:8080
HTTP_REQUEST_TIMEOUT=5s
HTTP_SHUTDOWN_TIMEOUT=45s
HTTP_MAX_HEADER_BYTES=16384

# 身份映射。值是文件路径，不是 Token。示例文件只含 SHA-256。
AUTH_CONFIG_REF=config/identities.example.json

# MySQL
MYSQL_DSN=notifier:notifier@tcp(127.0.0.1:3306)/notifier?parseTime=true&charset=utf8mb4
MYSQL_OPERATION_TIMEOUT=2s

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# RocketMQ（gRPC Proxy 接入端点）
ROCKETMQ_ENDPOINT=127.0.0.1:8081
ROCKETMQ_TOPIC_IMMEDIATE=notifier-delivery
ROCKETMQ_TOPIC_DELAYED=notifier-delivery-delay
ROCKETMQ_GROUP=notifier-worker

# 投递执行参数
DELIVERY_PARALLELISM=10
DELIVERY_HTTP_TIMEOUT=10s
DELIVERY_LEASE_TIMEOUT=30s
DELIVERY_MQ_INVISIBLE=60s
DELIVERY_MAX_ATTEMPTS=8
DELIVERY_BACKOFF_INITIAL=5s
DELIVERY_BACKOFF_CAP=5m
DELIVERY_SERVER_WAIT_CAP=1h
DELIVERY_ROUND_DEADLINE=24h
DELIVERY_BLOCKED_CHECK=60s

# Outbox 与补偿
OUTBOX_POLL_INTERVAL=1s
OUTBOX_GRACE_PERIOD=5m
RECOVERY_SCAN_INTERVAL=30s

# 保留与缓存
RETENTION_OVERVIEW_CACHE=5s
RETENTION_RESOLVED_AFTER=720h

# 请求、响应、错误摘要共用的 UTF-8 字节上限
SUMMARY_MAX_BYTES=2048

# 日志
LOG_LEVEL=info
LOG_FORMAT=json
